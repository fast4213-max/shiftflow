# Edge Functions 用のシークレット(値はコミットしない)
# 実際の値は `supabase secrets set --env-file supabase/.env` か
# Supabase ダッシュボードの Edge Functions → Secrets で設定する。

# Google Cloud で作ったサービスアカウントの鍵(JSON)を1行にしたもの
GOOGLE_SERVICE_ACCOUNT_JSON=

# 以下は Supabase が Edge Functions に自動で渡すので設定不要
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY

# ローカルで `supabase start` するときだけ使う(Google ログイン用の OAuth クライアント)
# 本番はダッシュボードの Authentication → Sign In / Providers → Google に入れる
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
