# Edge Functions 用のシークレット(値はコミットしない)
# 実際の値は Supabase ダッシュボードの Edge Functions → Secrets で設定する
# (ローカルで試すときは `supabase secrets set --env-file supabase/.env`)。

# Google Cloud で作ったサービスアカウントの鍵(JSON ファイルの中身をそのまま)
GOOGLE_SERVICE_ACCOUNT_JSON=

# 管理画面に入るパスワード(12文字以上)
ADMIN_PASSWORD=

# お問い合わせ(docs/contact/SETUP.md)
# Discord の Webhook の URL(https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=
# 専用 Gmail の GAS のウェブアプリの URL(https://script.google.com/macros/s/.../exec)
MAIL_RELAY_URL=
# GAS と同じ合言葉(GAS の makeSecret で作る64文字)
MAIL_RELAY_SECRET=

# 以下は Supabase が Edge Functions に自動で渡すので設定不要
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
